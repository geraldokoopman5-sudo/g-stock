# Copy to .env.local in this directory. Never commit .env.local.
# Loaded only in Development. Real environment variables/CLI options take priority.
ConnectionStrings__DefaultConnection="Host=localhost;Port=5432;Database=gstock_dev;Username=postgres;Password=YOUR_LOCAL_PASSWORD"

# Initialize-DevelopmentAuth.ps1 generates these four settings if absent.
# PEM values must be JSON-quoted strings with escaped newlines (\n).
# Auth__Issuer="gstock-dev"
# Auth__SigningKeyId="YOUR_KEY_ID"
# Auth__PrivateKeyPem="YOUR_PRIVATE_KEY_PEM_WITH_ESCAPED_NEWLINES"
# Auth__SigningKeys__YOUR_KEY_ID="YOUR_PUBLIC_KEY_PEM_WITH_ESCAPED_NEWLINES"
