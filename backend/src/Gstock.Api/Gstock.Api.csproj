<Project Sdk="Microsoft.NET.Sdk.Web">

  <ItemGroup>
    <ProjectReference Include="..\Gstock.Contracts\Gstock.Contracts.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.14" />
    <PackageReference Include="Npgsql" Version="10.0.3" />
    <PackageReference Include="Sodium.Core" Version="1.4.1" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>23381db9-edea-4f84-a294-637eb63b4596</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="../../migrations/*.sql"
                      LogicalName="Gstock.Migrations.%(Filename)%(Extension)" />
    <Content Update="appsettings.Local.json"
             CopyToOutputDirectory="Never" CopyToPublishDirectory="Never" />
  </ItemGroup>

</Project>
