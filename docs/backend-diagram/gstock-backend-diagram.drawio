        <mxCell id="235" value="RefreshTokenService detects a consumed token, revokes its whole session family, commits" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;fontFamily=Segoe UI;fontSize=11;fontColor=#182B3A;fontStyle=0;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="706" y="659" width="444.798828125" height="14.850000000000001" as="geometry" />
        </mxCell>
        <mxCell id="236" value="that revocation, and only then returns 401. A generic exception rollback must not undo this" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;fontFamily=Segoe UI;fontSize=11;fontColor=#182B3A;fontStyle=0;spacing=0;" vertex="1" parent="1">
